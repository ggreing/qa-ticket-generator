{
  "name": "qa-ticket-generator",
  "version": "0.0.0",
  "description": "GitHub Action that cross-checks PR diffs against linked PRDs (GitHub Issues, Jira, Notion) with Claude and publishes BDD QA scenarios to the PR and Slack.",
  "license": "Apache-2.0",
  "author": "ggreing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggreing/qa-ticket-generator.git"
  },
  "homepage": "https://github.com/ggreing/qa-ticket-generator#readme",
  "bugs": {
    "url": "https://github.com/ggreing/qa-ticket-generator/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "qa-ticket-generator": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^1.8.0",
    "@notionhq/client": "^5.31.1",
    "@slack/web-api": "^8.3.0",
    "web-tree-sitter": "^0.27.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "undici": "^8.12.4",
    "vitest": "^5.1.0"
  }
}
